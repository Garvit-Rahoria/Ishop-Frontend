# ---------------------------------------------------------------------------
# Backend API URL — set this in Vercel → Project Settings → Environment Variables
# Replace with your actual Render backend URL, e.g.:
#   https://ishop-backend.onrender.com/api
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=https://your-render-backend.onrender.com/api
API_BASE_URL=https://your-render-backend.onrender.com/api

# Image base URLs (must match the backend URL above)
NEXT_PUBLIC_CATEGORY_IMAGE=https://your-render-backend.onrender.com/category
NEXT_PUBLIC_BRAND_IMAGE=https://your-render-backend.onrender.com/brand
NEXT_PUBLIC_PRODUCT_IMAGE=https://your-render-backend.onrender.com/product

# Razorpay (use live key in production)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
